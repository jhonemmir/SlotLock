APP_NAME=SlotLock
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos (PostgreSQL via Docker)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=slotlock
DB_USERNAME=slotlock
DB_PASSWORD=slotlock
DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SlotLock — dominio
SLOT_MINUTES=15
MAX_DURATION_MINUTES=240
HOLD_TTL_MINUTES=10
WAITLIST_HOLD_TTL_MINUTES=5
IDEMPOTENCY_TTL_HOURS=24

# Simulación (demo). En Docker, compose fija SIMULATE_BASE_URL=http://nginx.
SIMULATE_MAX_N=50
SIMULATE_TIMEOUT_SECONDS=15

# Docker (UID/GID del host para el bind mount)
APP_PORT=8000
HOST_UID=1000
HOST_GID=1000

# pgAdmin (perfil "tools": docker compose --profile tools up)
PGADMIN_EMAIL=admin@slotlock.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Gatekeeping de escrituras (público, no es auth)
DEMO_API_KEY=slotlock-demo
