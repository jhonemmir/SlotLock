# Aplicación
APP_NAME=SlotLock
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Base de datos (PostgreSQL via Docker)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=slotlock
DB_USERNAME=slotlock
DB_PASSWORD=slotlock

# pgAdmin (perfil "tools": docker compose --profile tools up)
PGADMIN_EMAIL=admin@slotlock.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Holds
HOLD_TTL_MINUTES=10
HOLD_CLEANUP_INTERVAL_SECONDS=60

# Rate limiting del endpoint de simulación
SIMULATE_MAX_N=100
SIMULATE_RATE_LIMIT_PER_MINUTE=5
